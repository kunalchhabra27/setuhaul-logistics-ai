# Copy to .env for local development. Never commit real credentials.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=setuhaul-exception-agent

# TMS Supabase connection. The publishable key is paired with each caller JWT;
# normal API requests never use a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
ENVIRONMENT=development
LOG_LEVEL=INFO
